---
import Base from '../layouts/Base.astro';
import Map from '../components/Map.astro';
import { contact, tel } from '../data/site';

const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${contact.street}, ${contact.postalCode} ${contact.city}`)}`;
const [user, domain] = contact.email.split('@');
// Same as the links in Impressum and Datenschutz (src/layouts/Legal.astro)
const link = 'underline underline-offset-4 decoration-ink/30 transition-colors hover:decoration-ink';
---

<Base title="Kontakt" description={`${contact.firm}, ${contact.street}, ${contact.postalCode} ${contact.city}. Telefon ${contact.phones[0]}, E-Mail ${contact.email}.`}>
  <h1 class="text-2xl font-bold">Kontakt</h1>

  <div class="mt-4 lg:mt-8 max-w-4xl space-y-6">
    <p>Rufen Sie an oder schreiben Sie uns: Wir melden uns persönlich und behandeln Ihr Anliegen vertraulich.</p>

    <address class="not-italic">
      {contact.firm}<br />
      {contact.street}<br />
      {contact.postalCode} {contact.city}
    </address>

    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-6">
      <dt class="font-bold">Telefon:</dt>
      <dd>
        {contact.phones.map((phone) => (
          <a href={tel(phone)} class:list={['block w-fit', link]}>{phone}</a>
        ))}
      </dd>
      <dt class="font-bold">E-Mail:</dt>
      <dd><a href={`mailto:${contact.email}`} class={link}>{user}@<wbr />{domain}</a></dd>
    </dl>

    <section aria-labelledby="anfahrt">
      <h2 id="anfahrt" class="font-bold">Anfahrt</h2>
      <p>
        Mit der S-Bahn (S7 ab Zürich HB) bis Bahnhof Stäfa, von dort zu Fuss in 7 Minuten (ca. 700 Meter).<br />
        Gelb markierte Besucherparkplätze sind vorhanden.
      </p>
    </section>
  </div>

  <div class="mt-10">
    <Map />
    <p class="mt-6">
      <a href={routeUrl} class="inline-block border-b-4 border-ink pb-0.5 font-bold transition-colors hover:border-transparent">Route planen</a>
    </p>
  </div>
</Base>
