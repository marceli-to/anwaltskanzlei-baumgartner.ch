---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { contact, site } from '../data/site';
import Panel from '../components/Panel.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Page name, shown before the firm's name in the title; the homepage has none */
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : `${site.name} – Recht am Zürichsee`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  '@id': `${site.url}/#kanzlei`,
  name: site.name,
  url: `${site.url}/`,
  description: site.description,
  email: `mailto:${contact.email}`,
  telephone: contact.phones,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    postalCode: contact.postalCode,
    addressLocality: contact.city,
    addressCountry: contact.country,
  },
  areaServed: 'CH',
  image: ogImage,
  logo: new URL('/icon-512.png', Astro.site).href,
  founder: { '@type': 'Person', name: contact.name, jobTitle: 'Rechtsanwalt' },
};
---

<!doctype html>
<html lang="de-CH" class="overflow-y-scroll">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Better Call Andy – Anwaltskanzlei Dr. iur. Andreas Baumgartner, Recht am Zürichsee" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicons, app icons and og.png are rendered from scripts/assets/ with `npm run assets` -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Die Kanzlei in Kurzform, für Sprachmodelle" />

    <Font cssVariable="--font-host-grotesk" preload />
    <Font cssVariable="--font-anton" preload />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-white text-ink antialiased font-sans text-[17px] lg:text-lg leading-[1.4] lg:leading-25 selection:bg-ink selection:text-white">
    <div class="flex flex-col lg:grid lg:grid-cols-[38.85%_minmax(0,1fr)] min-h-[calc(100svh-45px)]">
      <Panel />
      <div class="contents lg:flex lg:flex-col">
        <Header />
        <main class="flex-1 px-16 sm:px-32 lg:pl-[clamp(32px,4.375vw,84px)] lg:pr-32 pt-40 lg:pt-63 pb-64 lg:pb-32">
          <div class="max-w-[1060px]">
            <slot />
          </div>
        </main>
      </div>
    </div>
    <Footer />
  </body>
</html>
