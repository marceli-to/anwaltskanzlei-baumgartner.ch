---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { contact, site } from '../data/site';
import Panel from '../components/Panel.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Page name, shown before the firm's name in the title; the homepage has none */
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : `${site.name} – Recht am Zürichsee`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  '@id': `${site.url}/#kanzlei`,
  name: site.name,
  url: `${site.url}/`,
  description: site.description,
  email: `mailto:${contact.email}`,
  telephone: contact.phones,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    postalCode: contact.postalCode,
    addressLocality: contact.city,
    addressCountry: contact.country,
  },
  areaServed: 'CH',
  image: ogImage,
  logo: new URL('/icon-512.png', Astro.site).href,
  founder: { '@type': 'Person', name: contact.name, jobTitle: 'Rechtsanwalt' },
};
---

<!doctype html>
<html lang="de-CH" class="overflow-y-scroll md:overscroll-none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Better Call Andy – Anwaltskanzlei Dr. iur. Andreas Baumgartner, Recht am Zürichsee" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Favicons, app icons and og.png are rendered from scripts/assets/ with `npm run assets` */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Die Kanzlei in Kurzform, für Sprachmodelle" />

    <Font cssVariable="--font-host-grotesk" preload />
    <Font cssVariable="--font-anton" preload />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-white text-ink antialiased font-sans text-base selection:bg-ink selection:text-white">
    {/* From md the photo panel spans both rows, so it stays sticky to the end and the footer lies on top of it:
       on a short page the grid is one viewport high and the footer covers the bottom of the photo */}
    <div class="grid grid-rows-[auto_1fr_auto] md:grid-cols-[40%_minmax(0,1fr)] md:grid-rows-[1fr_auto] min-h-dvh">
      <Panel />
      {/* One wrapper for header and main, so the sticky header stays put across the whole content */}
      <div class="flex flex-col md:col-start-2 md:row-start-1">
        <Header />
        <main class="flex-1 px-6 pt-18 pb-24 md:pr-12 md:pl-10 xl:pr-18 xl:pl-14 2xl:pr-24 2xl:pl-20">
          <div class="max-w-5xl">
            <slot />
          </div>
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
