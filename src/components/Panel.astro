---
// The photo panel with "Better Call Andy": a hero block above the content below md, from md the left column,
// sticky and one viewport high. Logo at the top, the CTA circle at the bottom right.
import { Image } from 'astro:assets';
import mountain from '../assets/mountain.jpg';
---

<aside class="relative isolate overflow-hidden flex flex-col justify-between h-[85svh] px-6 pt-12 pb-22 md:sticky md:top-0 md:col-start-1 md:row-start-1 md:row-span-2 md:self-start md:h-dvh md:px-10 xl:px-18 2xl:px-20">
  <Image
    src={mountain}
    alt=""
    widths={[640, 960, 1280, 1640]}
    sizes="(min-width: 48rem) 40vw, 100vw"
    loading="eager"
    fetchpriority="high"
    class="panel-photo absolute inset-0 -z-10 size-full object-cover scale-110"
  />

  <a href="/" class="flex flex-col self-start font-display text-ink">
    <span class="border-b-5 pb-6 uppercase text-logo">Better<br />Call<br />Andy</span>
    <span class="mt-6 text-logo-sub">Dr. iur.<br />Andreas Baumgartner<br />Rechtsanwalt</span>
  </a>

  <a href="/kontakt/" class="grid place-content-center size-32 self-end rounded-full bg-white font-display text-cta text-ink transition-transform duration-300 hover:scale-105">
    <span class="border-b-4 pb-1.5">Kontaktieren<br />Sie uns</span>
  </a>
</aside>
