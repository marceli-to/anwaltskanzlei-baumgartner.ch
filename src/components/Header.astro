---
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="order-first bg-white">
  <nav aria-label="Hauptnavigation" class="flex justify-center sm:justify-end h-15 lg:h-21 px-4 sm:px-8 lg:pr-12 xl:pr-24 2xl:pr-40">
    <ul class="flex gap-5 sm:gap-10 xl:gap-16">
      {nav.map(({ label, href }) => {
        const active = path === href;
        return (
          <li>
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'block pt-4.5 lg:pt-8 pb-1.5 text-sm border-b-4 transition-colors',
                active ? 'border-ink' : 'border-transparent hover:border-ink',
              ]}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
