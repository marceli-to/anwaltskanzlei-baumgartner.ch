---
import { contact, legalNav, nav, tel } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
---

{/* From md a sticky white bar across the content column. Below md only the fixed burger is left */}
<header class="md:sticky md:top-0 md:z-10 md:bg-white">
  <nav aria-label="Hauptnavigation" class="max-md:hidden md:pt-40 md:pb-16 md:pr-48 md:pl-40 xl:pr-72 xl:pl-56 2xl:pr-96 2xl:pl-80">
    <ul class="flex flex-wrap justify-end gap-x-24 gap-y-16 lg:gap-x-56 2xl:gap-x-64">
      {nav.map(({ label, href }) => {
        const active = path === href;
        return (
          <li>
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'block pb-8 text-sm border-b-3 transition-colors',
                active ? 'border-ink' : 'border-transparent hover:border-ink',
              ]}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <button
    type="button"
    data-menu-open
    aria-haspopup="dialog"
    aria-controls="menu"
    class="fixed top-12 right-12 z-20 grid place-content-center size-44 cursor-pointer text-ink md:hidden"
  >
    <span class="sr-only">Menü öffnen</span>
    <svg width="24" height="16" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 1h24M0 8h24M0 15h24" stroke="currentColor" stroke-width="2" /></svg>
  </button>

  <dialog id="menu" aria-label="Menü" class="menu fixed inset-0 m-0 size-full max-h-none max-w-none overflow-y-auto overscroll-contain bg-ink text-white md:hidden">
    <div class="flex min-h-full flex-col px-24 pt-24 pb-32">
      <button type="button" data-menu-close class="fixed top-12 right-12 grid place-content-center size-44 cursor-pointer">
        <span class="sr-only">Menü schliessen</span>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M1 1l18 18M19 1L1 19" stroke="currentColor" stroke-width="2" /></svg>
      </button>

      <nav aria-label="Hauptnavigation" class="mt-56">
        <ul class="space-y-16 font-display text-logo uppercase">
          {nav.map(({ label, href }) => {
            const active = path === href;
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'inline-block border-b-4 pb-4 transition-colors',
                    active ? 'border-white' : 'border-transparent hover:border-white',
                  ]}
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="mt-auto pt-56 text-xs space-y-16">
        <p>
          {contact.phones.map((phone) => <a href={tel(phone)} class="block w-fit">{phone}</a>)}
          <a href={`mailto:${contact.email}`} class="block w-fit">{contact.email}</a>
        </p>
        <ul class="flex flex-wrap items-center">
          {legalNav.map(({ label, href }, i) => (
            <li class="flex items-center">
              {i > 0 && <span class="px-8" aria-hidden="true">I</span>}
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </dialog>
</header>

<script>
  const menu = document.querySelector<HTMLDialogElement>('#menu');

  if (menu) {
    document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu.showModal());
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    // The menu only exists below md: close it when the window grows past that, or the page stays inert
    matchMedia('(width >= 48rem)').addEventListener('change', (event) => event.matches && menu.close());
  }
</script>
