---
import { legalNav } from '../data/site';
---

<footer class="relative z-10 bg-ink text-white">
  <nav aria-label="Rechtliches" class="min-h-(--footer-height) flex items-center px-4 sm:px-8 lg:px-12 xl:px-16 2xl:px-24 py-2.5">
    <ul class="flex flex-wrap items-center text-xs">
      {legalNav.map(({ label, href }, i) => (
        <li class="flex items-center">
          {i > 0 && <span class="px-2.5" aria-hidden="true">I</span>}
          <a href={href} class="underline decoration-transparent underline-offset-4 transition-colors hover:decoration-white">{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</footer>
