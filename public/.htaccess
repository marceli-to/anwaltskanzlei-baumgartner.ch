# Deployed with the site (see deploy.sh). Text files are UTF-8: without this
# Apache sends text/plain without a charset and browsers garble llms.txt.
AddCharset utf-8 .txt

# One address: https, without www (staging is https already and has no www, so it passes).
# Certificate validation under /.well-known/ stays reachable over plain http.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# The sitemap used to be sitemap-index.xml plus sitemap-0.xml (@astrojs/sitemap); now it is one /sitemap.xml
Redirect 301 /sitemap-index.xml /sitemap.xml
Redirect 301 /sitemap-0.xml /sitemap.xml

AddType application/manifest+json .webmanifest

# Unknown addresses get the site's own 404 page instead of Apache's
ErrorDocument 404 /404.html

# Caching. Files in /_astro/ (CSS, JS, images, fonts) have a content hash in their name,
# so a changed file gets a new address and the old one can be kept for a year.
# Everything else keeps its address across deploys: pages are revalidated on every
# visit (a cheap 304 via ETag), so a deploy shows up immediately; icons, og.png and
# the text files are kept for a day.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=86400"
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#(^|/|\.html)$#">
    Header set Cache-Control "no-cache"
  </ElseIf>
</IfModule>
